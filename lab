# Lightweight Pure-Python Kubernetes Client (In-Cluster / Kubeconfig / kubectl)
# ---------------------------------------------------------------------------

def _parse_simple_kubeconfig(path: str) -> dict[str, str] | None:
    """Extract server, ca PEM, token, and namespace from standard kubeconfig YAML."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
    except OSError:
        return None

    server_m = re.search(r"^\s*server:\s*(\S+)\s*$", content, re.M)
    token_m = re.search(r"^\s*token:\s*(\S+)\s*$", content, re.M)
    ca_m = re.search(r"^\s*certificate-authority-data:\s*(\S+)\s*$", content, re.M)
    ns_m = re.search(r"^\s*namespace:\s*(\S+)\s*$", content, re.M)

    if not server_m or not token_m:
        return None

    res = {
        "server": server_m.group(1).strip("'\"").rstrip("/"),
        "token": token_m.group(1).strip("'\""),
        "namespace": ns_m.group(1).strip("'\"") if ns_m else DEFAULT_NAMESPACE,
    }
    if ca_m:
        try:
            res["ca_pem"] = base64.b64decode(ca_m.group(1).strip("'\"")).decode("utf-8")
        except Exception:
            pass
    return res


class K8sClient:
    def __init__(self, demo_mode: bool = False) -> None:
        self.demo_mode = demo_mode
        self.mode = "demo" if demo_mode else "uninitialized"
        self.namespace = os.environ.get("TRAINING_NAMESPACE", DEFAULT_NAMESPACE)
        self.server = ""
        self.token = ""
        self.ssl_ctx: ssl.SSLContext | None = None
        self.kubeconfig_path = ""
        self._kubeconfig_mtime = 0.0
        self._lock = threading.Lock()
        self._cache_ts = 0.0
        self._cache_data: dict[str, Any] | None = None
        self._nodes_ts = 0.0
        self._nodes_cache: list[dict[str, Any]] = []
        self._persisted_lock = threading.Lock()
        self._persisted_mem: dict[str, set[str]] = {}

        if not demo_mode:
            self._init_transport()

    def can_local_setup(self) -> bool:
        return bool(
            not self.demo_mode
            and self.mode != "in-cluster"
            and os.path.isfile(os.path.join(REPO_ROOT, "setup.sh"))
        )

    def _kubeconfig_candidates(self) -> list[str]:
        candidates: list[str] = []
        if os.environ.get("KUBECONFIG"):
            candidates.extend(p for p in os.environ["KUBECONFIG"].split(os.pathsep) if p)
        candidates.append(os.path.join(REPO_ROOT, "kubeconfig.yaml"))
        candidates.append(os.path.expanduser("~/.kube/config"))
        return candidates

    def _maybe_reload_transport(self) -> None:
        if self.demo_mode:
            return
        for kc in self._kubeconfig_candidates():
            if kc and os.path.isfile(kc):
                try:
                    mtime = os.path.getmtime(kc)
                except OSError:
                    mtime = 0.0
                if kc != self.kubeconfig_path or mtime != self._kubeconfig_mtime or self.mode not in ("rest-kubeconfig", "kubectl"):
                    self._init_transport()
                return
        if self.mode == "uninitialized":
            self._init_transport()

    def _init_transport(self) -> None:
        # 1. Always prefer explicit kubeconfig files (~/.kube/config from ./setup.sh, KUBECONFIG, ./kubeconfig.yaml).
        #    Inside Coder workspace pods, /var/run/secrets/kubernetes.io/serviceaccount/token belongs to the
        #    unprivileged 'coder' namespace default ServiceAccount and MUST NOT shadow ~/.kube/config!
        for kc in self._kubeconfig_candidates():
            if kc and os.path.isfile(kc):
                self.kubeconfig_path = kc
                try:
                    self._kubeconfig_mtime = os.path.getmtime(kc)
                except OSError:
                    self._kubeconfig_mtime = 0.0
                parsed = _parse_simple_kubeconfig(kc)
                if parsed:
                    self.server = parsed["server"]
                    self.token = parsed["token"]
                    self.namespace = os.environ.get("TRAINING_NAMESPACE") or parsed.get("namespace", DEFAULT_NAMESPACE)
                    ctx = ssl.create_default_context()
                    if parsed.get("ca_pem"):
                        ctx.load_verify_locations(cadata=parsed["ca_pem"])
                    self.ssl_ctx = ctx
                    self.mode = "rest-kubeconfig"
                    return
                if shutil.which("kubectl"):
                    self.mode = "kubectl"
                    return

        # 2. In-cluster ServiceAccount (used by training-hub Deployment in training-nov-26; skip inside Coder workspaces)
        sa_tok = "/var/run/secrets/kubernetes.io/serviceaccount/token"
        sa_ca = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
        sa_ns = "/var/run/secrets/kubernetes.io/serviceaccount/namespace"
        is_coder_workspace = bool(os.environ.get("CODER_AGENT_TOKEN"))
        if os.path.isfile(sa_tok) and not is_coder_workspace:
            try:
                pod_ns = ""
                if os.path.isfile(sa_ns):
                    with open(sa_ns, "r", encoding="utf-8") as f:
                        pod_ns = f.read().strip()
                if pod_ns != "coder":
                    with open(sa_tok, "r", encoding="utf-8") as f:
                        self.token = f.read().strip()
                    self.namespace = os.environ.get("TRAINING_NAMESPACE") or pod_ns or self.namespace
                    host = os.environ.get("KUBERNETES_SERVICE_HOST", "kubernetes.default.svc")
                    port = os.environ.get("KUBERNETES_SERVICE_PORT", "443")
                    if ":" in host and not host.startswith("["):
                        host = f"[{host}]"
                    self.server = f"https://{host}:{port}"
                    ctx = ssl.create_default_context(cafile=sa_ca if os.path.isfile(sa_ca) else None)
                    self.ssl_ctx = ctx
                    self.mode = "in-cluster"
                    return
            except Exception:
                pass

        self.mode = "uninitialized"

    def _rest_request(
        self,
        path: str,
        method: str = "GET",
        body: dict[str, Any] | None = None,
        content_type: str = "application/json",
        timeout: float = 3.5,
    ) -> dict[str, Any]:
        url = f"{self.server}{path}"
        data_bytes = json.dumps(body).encode("utf-8") if body is not None else None
        req = urllib.request.Request(url, data=data_bytes, method=method)
        req.add_header("Authorization", f"Bearer {self.token}")
        req.add_header("Accept", "application/json")
        if data_bytes is not None:
            req.add_header("Content-Type", content_type)
        with urllib.request.urlopen(req, context=self.ssl_ctx, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))

    def _kubectl_get(self, resource: str, cluster_scoped: bool = False) -> list[dict[str, Any]]:
        cmd = ["kubectl"]
        if self.kubeconfig_path:
            cmd.append(f"--kubeconfig={self.kubeconfig_path}")
        if not cluster_scoped:
            cmd.extend(["-n", self.namespace])
        cmd.extend(["get", resource, "-o", "json", "--request-timeout=4s"])
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=6)
        if proc.returncode != 0:
            raise RuntimeError(proc.stderr.strip() or f"kubectl get {resource} failed")
        payload = json.loads(proc.stdout)
        return payload.get("items", [])

    def _fetch_items(self, api_path: str, kubectl_kind: str, cluster_scoped: bool = False) -> list[dict[str, Any]]:
        if self.mode in ("in-cluster", "rest-kubeconfig"):
            data = self._rest_request(api_path)
            return data.get("items", [])
        if self.mode == "kubectl":
            return self._kubectl_get(kubectl_kind, cluster_scoped=cluster_scoped)
        raise RuntimeError("No Kubernetes credentials found — run ./setup.sh first to install ~/.kube/config.")

    def save_progress(self, user: str, completed_map: dict[str, str]) -> None:
        if not user or self.demo_mode:
            return
        cm_name = f"lab-state-{user}"
        payload = {
            "apiVersion": "v1",
            "kind": "ConfigMap",
            "metadata": {
                "name": cm_name,
                "namespace": self.namespace,
                "labels": {
                    "app.kubernetes.io/part-of": "berkelium-lab",
                    "berkelium.lbl.gov/trainee": user,
                },
            },
            "data": {
                "completed_json": json.dumps(completed_map, sort_keys=True),
                "updated_at": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            },
        }
        try:
            if self.mode in ("in-cluster", "rest-kubeconfig"):
                base = f"/api/v1/namespaces/{self.namespace}/configmaps"
                try:
                    self._rest_request(
                        f"{base}/{cm_name}",
                        method="PATCH",
                        body={"metadata": payload["metadata"], "data": payload["data"]},
                        content_type="application/strategic-merge-patch+json",
                    )
                except urllib.error.HTTPError as e:
                    if e.code == 404:
                        self._rest_request(base, method="POST", body=payload)
            elif self.mode == "kubectl":
                cmd = ["kubectl"]
                if self.kubeconfig_path:
                    cmd.append(f"--kubeconfig={self.kubeconfig_path}")
                cmd.extend(["-n", self.namespace, "apply", "-f", "-"])
                subprocess.run(cmd, input=json.dumps(payload), text=True, capture_output=True, timeout=5)
        except Exception:
            pass

    def get_snapshot(self, force: bool = False) -> dict[str, Any]:
        self._maybe_reload_transport()
        now = time.monotonic()
        with self._lock:
            if not force and self._cache_data is not None and (now - self._cache_ts) < 2.0:
                return self._cache_data

        if self.demo_mode:
            snap = _build_demo_snapshot()
            with self._lock:
                self._cache_data = snap
                self._cache_ts = now
            return snap

        ns = self.namespace
        tasks: dict[str, tuple[str, str, bool]] = {
            "pods": (f"/api/v1/namespaces/{ns}/pods", "pods", False),
            "jobs": (f"/apis/batch/v1/namespaces/{ns}/jobs", "jobs", False),
            "deployments": (f"/apis/apps/v1/namespaces/{ns}/deployments", "deployments", False),
            "services": (f"/api/v1/namespaces/{ns}/services", "services", False),
            "pvcs": (f"/api/v1/namespaces/{ns}/persistentvolumeclaims", "pvc", False),
            "httproutes": (f"/apis/gateway.networking.k8s.io/v1/namespaces/{ns}/httproutes", "httproutes", False),
            "resourceclaims": (f"/apis/resource.k8s.io/v1/namespaces/{ns}/resourceclaims", "resourceclaims", False),
            "configmaps": (
                f"/api/v1/namespaces/{ns}/configmaps?labelSelector=app.kubernetes.io%2Fpart-of%3Dberkelium-lab",
                "configmaps",
                False,
            ),
        }
        fetch_nodes = (now - self._nodes_ts) > 15.0 or not self._nodes_cache
        if fetch_nodes:
            tasks["nodes"] = ("/api/v1/nodes", "nodes", True)

        results: dict[str, list[dict[str, Any]]] = {k: [] for k in tasks}
        errors: list[str] = []

        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            futs = {
                pool.submit(self._fetch_items, path, kind, cscoped): key
                for key, (path, kind, cscoped) in tasks.items()
            }
            for fut, key in futs.items():
                try:
                    results[key] = fut.result()
                except Exception as exc:
                    if key in ("pods", "jobs"):
                        errors.append(str(exc))

        if fetch_nodes and results.get("nodes"):
            self._nodes_cache = results["nodes"]
            self._nodes_ts = now

        connected = len(errors) == 0
        snap = self._evaluate_all(
            connected=connected,
            error=errors[0] if errors else "",
            pods=results["pods"],
            jobs=results["jobs"],
            deployments=results["deployments"],
            services=results["services"],
            pvcs=results["pvcs"],
            httproutes=results["httproutes"],
            resourceclaims=results["resourceclaims"],
            configmaps=results["configmaps"],
            nodes=self._nodes_cache,
        )
        with self._lock:
            self._cache_data = snap
            self._cache_ts = now
        return snap

    def _evaluate_all(
        self,
        *,
        connected: bool,
        error: str,
        pods: list[dict[str, Any]],
        jobs: list[dict[str, Any]],
        deployments: list[dict[str, Any]],
        services: list[dict[str, Any]],
        pvcs: list[dict[str, Any]],
        httproutes: list[dict[str, Any]],
        resourceclaims: list[dict[str, Any]],
        configmaps: list[dict[str, Any]],
        nodes: list[dict[str, Any]],
    ) -> dict[str, Any]:
        def _active(items: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
            return {
                it.get("metadata", {}).get("name", ""): it
                for it in items
                if not it.get("metadata", {}).get("deletionTimestamp")
            }

        pods_by_name = _active(pods)
        jobs_by_name = _active(jobs)
        deps_by_name = _active(deployments)
        svcs_by_name = _active(services)
        pvcs_by_name = _active(pvcs)
        routes_by_name = _active(httproutes)

        # Discover all active trainees from lab-state-* ConfigMaps AND suffixed K8s objects
        persisted: dict[str, dict[str, str]] = {}
        users: set[str] = set()
        configured_u = read_configured_user()
        suggested_u = read_local_user()
        if configured_u:
            users.add(configured_u)

        for cm in configmaps:
            meta = cm.get("metadata", {})
            labels = meta.get("labels") or {}
            if labels.get("app.kubernetes.io/part-of") != "berkelium-lab":
                continue
            u = sanitize_user(labels.get("berkelium.lbl.gov/trainee", ""))
            if not u and meta.get("name", "").startswith("lab-state-"):
                u = sanitize_user(meta["name"][len("lab-state-") :])
            if u:
                users.add(u)
                try:
                    persisted[u] = json.loads((cm.get("data") or {}).get("completed_json", "{}"))
                except Exception:
                    persisted[u] = {}

        all_names = (
            list(pods_by_name)
            + list(jobs_by_name)
            + list(deps_by_name)
            + list(svcs_by_name)
            + list(pvcs_by_name)
            + list(routes_by_name)
        )
        for obj_name in all_names:
            for pfx in KNOWN_RESOURCE_PREFIXES:
                if obj_name.startswith(pfx):
                    rest = obj_name[len(pfx) :]
                    # Ignore random Pod suffixes created by Jobs/ReplicaSets (e.g., cpu-job-alice-9x2k1)
                    if pfx in ("cpu-job-", "nvidia-smi-job-", "dynamic-mig-job-", "parallel-sweep-job-", "gpu-pytorch-job-", "boss-job-", "test-http-") and "-" in rest:
                        # Might be a generated pod name; match against known jobs/deployments first
                        continue
                    cand = sanitize_user(rest)
                    if cand and len(cand) <= 16:
                        users.add(cand)
                    break

        now_iso = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        user_states: dict[str, dict[str, Any]] = {}

        for u in sorted(users):
            live = _check_user_live(
                u,
                pods_by_name=pods_by_name,
                jobs_by_name=jobs_by_name,
                deps_by_name=deps_by_name,
                svcs_by_name=svcs_by_name,
                pvcs_by_name=pvcs_by_name,
                routes_by_name=routes_by_name,
            )
            saved = dict(persisted.get(u, {}))
            if not saved:
                with self._persisted_lock:
                    self._persisted_mem.pop(u, None)
            newly_added = False
            for cid, is_ok in live.items():
                if is_ok and cid not in saved:
                    saved[cid] = now_iso
                    newly_added = True

            if newly_added and connected:
                with self._persisted_lock:
                    known_set = self._persisted_mem.setdefault(u, set())
                    if not set(saved).issubset(known_set):
                        known_set.update(saved.keys())
                        threading.Thread(target=self.save_progress, args=(u, dict(saved)), daemon=True).start()

            quest_done: dict[str, bool] = {}
            for q in QUESTS:
                quest_done[q["id"]] = all((c["id"] in saved) for c in q["checks"])

            user_states[u] = {
                "user": u,
                "checks": {cid: (cid in saved) for cid in ALL_CHECK_IDS},
                "live_now": live,
                "timestamps": saved,
                "quests": quest_done,
                "score": sum(1 for cid in ALL_CHECK_IDS if cid in saved),
                "quests_completed": sum(1 for ok in quest_done.values() if ok),
            }

        gpu_pools = _summarize_gpu_telemetry(nodes, pods, resourceclaims)

        running_pods = sum(
            1
            for p in pods
            if p.get("status", {}).get("phase") == "Running"
            and not p.get("metadata", {}).get("name", "").startswith("training-hub-")
        )
        active_claims = sum(
            1
            for rc in resourceclaims
            if (rc.get("status", {}).get("allocation") is not None)
        )

        return {
            "connected": connected,
            "mode": self.mode,
            "namespace": self.namespace,
            "local_user": configured_u or suggested_u,
            "configured_user": configured_u,
            "suggested_user": suggested_u,
            "can_setup": self.can_local_setup(),
            "setup_complete": bool(connected and configured_u),
            "error": error,
            "updated_at": now_iso,
            "total_checks": len(ALL_CHECK_IDS),
            "users": user_states,
            "telemetry": {
                "attendees": len(user_states),
                "quests_solved_total": sum(st["quests_completed"] for st in user_states.values()),
                "running_pods": running_pods,
                "active_dra_claims": active_claims,
                "total_jobs": len(jobs),
                "gpu_pools": gpu_pools,
            },
        }


def _pod_ready_with_explicit_limits(pod: dict[str, Any] | None) -> bool:
    if not pod:
        return False
    if pod.get("status", {}).get("phase") != "Running":
        return False
    statuses = pod.get("status", {}).get("containerStatuses") or []
    if not statuses or not all(cs.get("ready") for cs in statuses):
        return False
    ann = (pod.get("metadata", {}).get("annotations") or {}).get("kubernetes.io/limit-ranger", "")
    if "limit for container" in ann:
        return False
    containers = pod.get("spec", {}).get("containers") or []
    for c in containers:
        lims = (c.get("resources") or {}).get("limits") or {}
        if not lims.get("cpu") or not lims.get("memory"):
            return False
    return True


def _pod_has_no_hostpath_and_has_emptydir(pod: dict[str, Any] | None) -> bool:
    if not pod:
        return False
    vols = pod.get("spec", {}).get("volumes") or []
    if any("hostPath" in v for v in vols):
        return False
    return any("emptyDir" in v for v in vols)


def _check_user_live(
    u: str,
    *,
    pods_by_name: dict[str, dict[str, Any]],
    jobs_by_name: dict[str, dict[str, Any]],
    deps_by_name: dict[str, dict[str, Any]],
    svcs_by_name: dict[str, dict[str, Any]],
    pvcs_by_name: dict[str, dict[str, Any]],
    routes_by_name: dict[str, dict[str, Any]],
) -> dict[str, bool]:
    sfx = f"-{u}" if u else ""

    # 1a: quest1-pod-<u> (or test-pod-<u>) Running with explicit limits
    q1_pod = pods_by_name.get(f"quest1-pod{sfx}") or pods_by_name.get(f"test-pod{sfx}")
    c_1a = _pod_ready_with_explicit_limits(q1_pod)

    # 1b: multi-container-pod-<u> 2/2 Ready
    mc_pod = pods_by_name.get(f"multi-container-pod{sfx}")
    mc_cs = (mc_pod or {}).get("status", {}).get("containerStatuses") or []
    c_1b = bool(mc_pod and len(mc_cs) >= 2 and all(cs.get("ready") for cs in mc_cs))

    # 2a: dra-gpu-pod-<u> Running OR nvidia-smi-job-<u> Succeeded
    dra_pod = pods_by_name.get(f"dra-gpu-pod{sfx}")
    smi_job = jobs_by_name.get(f"nvidia-smi-job{sfx}")
    c_2a = bool(
        (dra_pod and dra_pod.get("status", {}).get("phase") == "Running")
        or (smi_job and (smi_job.get("status", {}).get("succeeded") or 0) >= 1)
    )

    # 2b: dynamic-mig-job-<u> Succeeded
    mig_job = jobs_by_name.get(f"dynamic-mig-job{sfx}")
    c_2b = bool(mig_job and (mig_job.get("status", {}).get("succeeded") or 0) >= 1)

    # 3a: quest3-pvc-<u>, rbd-pvc-<u>, or cephfs-pvc-<u> Bound on ceph-rbd/cephfs
    c_3a = False
    for pvc_base in ("quest3-pvc", "rbd-pvc", "cephfs-pvc"):
        pvc = pvcs_by_name.get(f"{pvc_base}{sfx}")
        if pvc and pvc.get("status", {}).get("phase") == "Bound":
            sc = pvc.get("spec", {}).get("storageClassName", "")
            if sc in ("ceph-rbd", "cephfs"):
                c_3a = True
                break

    # 3b: quest3-pod-<u> Running (with PVC + emptyDir, no hostPath) OR (rbd/cephfs pod + nvme-scratch-pod)
    q3_pod = pods_by_name.get(f"quest3-pod{sfx}")
    rbd_or_fs = pods_by_name.get(f"rbd-pod{sfx}") or pods_by_name.get(f"cephfs-pod{sfx}")
    nvme_pod = pods_by_name.get(f"nvme-scratch-pod{sfx}")
    c_3b = bool(
        (
            q3_pod
            and q3_pod.get("status", {}).get("phase") == "Running"
            and _pod_has_no_hostpath_and_has_emptydir(q3_pod)
        )
        or (
            rbd_or_fs
            and rbd_or_fs.get("status", {}).get("phase") == "Running"
            and nvme_pod
            and nvme_pod.get("status", {}).get("phase") in ("Running", "Succeeded")
        )
    )

    # 4a: test-http-<u> >= 2 Available replicas + test-svc-<u> ClusterIP
    dep = deps_by_name.get(f"test-http{sfx}")
    svc = svcs_by_name.get(f"test-svc{sfx}")
    c_4a = bool(
        dep
        and (dep.get("status", {}).get("availableReplicas") or 0) >= 2
        and svc
        and svc.get("spec", {}).get("clusterIP")
    )

    # 4b: test-http-route-<u> Accepted=True
    hr = routes_by_name.get(f"test-http-route{sfx}")
    c_4b = False
    if hr:
        for parent in hr.get("status", {}).get("parents") or []:
            for cond in parent.get("conditions") or []:
                if cond.get("type") == "Accepted" and cond.get("status") == "True":
                    c_4b = True

    # 5a: parallel-sweep-job-<u> Indexed >= 6 succeeded
    sweep = jobs_by_name.get(f"parallel-sweep-job{sfx}")
    c_5a = bool(
        sweep
        and sweep.get("spec", {}).get("completionMode") == "Indexed"
        and (sweep.get("status", {}).get("succeeded") or 0) >= 6
    )

    # 5b: gpu-pytorch-job-<u> Succeeded
    pt_job = jobs_by_name.get(f"gpu-pytorch-job{sfx}")
    c_5b = bool(pt_job and (pt_job.get("status", {}).get("succeeded") or 0) >= 1)

    # 6a: boss-pvc-<u> Bound + boss-job-<u> Succeeded with explicit limits, no hostPath, no sleep infinity
    boss_pvc = pvcs_by_name.get(f"boss-pvc{sfx}")
    boss_job = jobs_by_name.get(f"boss-job{sfx}")
    c_6a = False
    if (
        boss_pvc
        and boss_pvc.get("status", {}).get("phase") == "Bound"
        and boss_pvc.get("spec", {}).get("storageClassName") in ("ceph-rbd", "cephfs")
        and boss_job
        and (boss_job.get("status", {}).get("succeeded") or 0) >= 1
    ):
        pod_spec = (boss_job.get("spec", {}).get("template") or {}).get("spec") or {}
        vols = pod_spec.get("volumes") or []
        ctrs = pod_spec.get("containers") or []
        no_hp = not any("hostPath" in v for v in vols)
        has_ed = any("emptyDir" in v for v in vols)
        lims_ok = all(
            (c.get("resources") or {}).get("limits", {}).get("cpu")
            and (c.get("resources") or {}).get("limits", {}).get("memory")
            for c in ctrs
        )
        cmd_str = " ".join(" ".join(c.get("command") or []) + " " + " ".join(c.get("args") or []) for c in ctrs)
        no_sleep = not re.search(r"\bsleep\s+infinity\b", cmd_str)
        c_6a = bool(no_hp and has_ed and lims_ok and no_sleep)

    return {
        "1a": c_1a,
        "1b": c_1b,
        "2a": c_2a,
        "2b": c_2b,
        "3a": c_3a,
        "3b": c_3b,
        "4a": c_4a,
        "4b": c_4b,
        "5a": c_5a,
        "5b": c_5b,
        "6a": c_6a,
    }


def _summarize_gpu_telemetry(
    nodes: list[dict[str, Any]],
    pods: list[dict[str, Any]],
    resourceclaims: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    pools: dict[str, dict[str, Any]] = {}
    node_to_model: dict[str, str] = {}

    for n in nodes:
        meta = n.get("metadata", {})
        labels = meta.get("labels") or {}
        nname = meta.get("name", "")
        schedulable = not n.get("spec", {}).get("unschedulable", False)
        product = labels.get("nvidia.com/gpu.product", "")
        amd_id = labels.get("amd.com/gpu.device-id", "")

        if product:
            model = (
                product.replace("NVIDIA-", "")
                .replace("-SXM4-80GB", " 80GB")
                .replace("-80GB-HBM3", " 80GB")
                .replace("-NVL", " NVL")
                .replace("-", " ")
            )
        elif amd_id:
            model = "AMD Instinct MI100"
        else:
            continue

        cap = n.get("status", {}).get("allocatable") or {}
        gpu_cnt = 0
        for k, v in cap.items():
            if k.startswith(("nvidia.com/", "amd.com/")) and k != "nvidia.com/mig.config":
                try:
                    gpu_cnt = max(gpu_cnt, int(v))
                except ValueError:
                    pass
        if gpu_cnt == 0:
            gpu_cnt = 8 if "B300" in model or "H100" in model or "A100" in model else 4

        node_to_model[nname] = model
        entry = pools.setdefault(
            model,
            {"model": model, "nodes": 0, "schedulable_nodes": 0, "total_gpus": 0, "workshop_active": 0, "mig_slices": 0},
        )
        entry["nodes"] += 1
        if schedulable:
            entry["schedulable_nodes"] += 1
            entry["total_gpus"] += gpu_cnt

    for p in pods:
        if p.get("status", {}).get("phase") != "Running":
            continue
        nname = p.get("spec", {}).get("nodeName", "")
        model = node_to_model.get(nname)
        if not model or model not in pools:
            continue
        has_gpu = False
        for c in p.get("spec", {}).get("containers") or []:
            reqs = (c.get("resources") or {}).get("requests") or {}
            claims = (c.get("resources") or {}).get("claims") or []
            if claims or any(k.startswith(("nvidia.com/", "amd.com/")) for k in reqs):
                has_gpu = True
        if has_gpu:
            pools[model]["workshop_active"] += 1

    for rc in resourceclaims:
        alloc = rc.get("status", {}).get("allocation") or {}
        for dev_res in alloc.get("devices", {}).get("results") or []:
            if dev_res.get("driver") == "gpu.nvidia.com" and "mig" in (dev_res.get("pool", "") + rc.get("metadata", {}).get("name", "")):
                for entry in pools.values():
                    if any(tag in entry["model"] for tag in ("H200", "B300", "A100", "H100")):
                        entry["mig_slices"] += 1
                        break

    order = {"B300": 0, "H200": 1, "H100": 2, "A100": 3, "A40": 4, "MI100": 5}
    return sorted(
        pools.values(),
        key=lambda x: next((rank for k, rank in order.items() if k in x["model"]), 99),
    )


def _build_demo_snapshot() -> dict[str, Any]:
    local_u = read_local_user() or "alice"
    demo_users = {
        local_u: ["1a", "1b", "2a", "2b", "3a"],
