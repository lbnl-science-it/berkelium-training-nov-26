            f"Progress: \033[1;32m{score}/{total}\033[0m"
        )
        if web_url:
            out.append(f"\033[36mBrowser UI running at:\033[0m \033[1m{web_url}\033[0m (Coder auto-proxies this port!)")
        if not snap.get("connected") and snap.get("error"):
            out.append(f"\033[33mCluster warning:\033[0m {snap['error'][:100]}")

        tabs_bar = []
        for i, q in enumerate(QUESTS):
            done = quests_ok.get(q["id"], False)
            mark = "\033[32m✓\033[0m" if done else f"{sum(1 for c in q['checks'] if checks.get(c['id']))}/{len(q['checks'])}"
            if not board_mode and i == quest_idx:
                tabs_bar.append(f"\033[7;1m [{q['num']} {mark}] \033[0m")
            else:
                tabs_bar.append(f" {q['num']}({mark}) ")
        b_lbl = "\033[7;1m [B: Classroom] \033[0m" if board_mode else " [B: Classroom] "
        out.append("".join(tabs_bar) + b_lbl)
        out.append("\033[2m" + ("─" * 76) + "\033[0m")

        if board_mode:
            tel = snap.get("telemetry") or {}
            out.append(
                f"\033[1mClassroom Live:\033[0m {tel.get('attendees', 0)} attendee(s)  |  "
                f"{tel.get('quests_solved_total', 0)} quest(s) solved  |  "
                f"{tel.get('running_pods', 0)} running pod(s)  |  "
                f"{tel.get('active_dra_claims', 0)} active GPU/MIG claim(s)"
            )
            out.append("")
            out.append("\033[1mGPU & Dynamic MIG Node Pools:\033[0m")
            for p in tel.get("gpu_pools") or []:
                mig_s = f", {p['mig_slices']} MIG slice(s)" if p.get("mig_slices") else ""
                out.append(
                    f"  • {p['model']:<22} {p['schedulable_nodes']}/{p['nodes']} nodes ({p['total_gpus']} GPUs) "
                    f"-> workshop active: {p['workshop_active']} pod(s){mig_s}"
                )
            out.append("")
            out.append("\033[1mAttendee           Q01   Q02   Q03   Q04   Q05   Q06   Score\033[0m")
            users_sorted = sorted(
                (snap.get("users") or {}).values(),
                key=lambda x: (-x["score"], x["user"]),
            )
            for st in users_sorted[:18]:
                cols = []
                for q in QUESTS:
                    dc = sum(1 for c in q["checks"] if st["checks"].get(c["id"]))
                    if dc == len(q["checks"]):
                        cols.append("\033[32m ✓   \033[0m")
                    elif dc > 0:
                        cols.append(f"\033[33m{dc}/{len(q['checks'])}  \033[0m")
                    else:
                        cols.append("\033[2m ·   \033[0m")
                out.append(f"{st['user']:<18} " + " ".join(cols) + f"  {st['score']}/{total}")
        else:
            q = QUESTS[quest_idx]
            out.append(f"\033[1;33mQuest {q['num']} — {q['title']}\033[0m \033[2m({q['duration']} · {q['module']})\033[0m")
            out.append(f"\033[2m{q['why']}\033[0m")
            out.append("")
            out.append("\033[1mLive Cluster Objectives (auto-updates every 3s):\033[0m")
            for c in q["checks"]:
                ok = checks.get(c["id"], False)
                box = "\033[1;32m[✓]\033[0m" if ok else "\033[33m[ ]\033[0m"
                out.append(f"  {box} \033[1m{render_tpl(c['title'], user)}\033[0m")
                out.append(f"      \033[2m{render_tpl(c['detail'], user)}\033[0m")

            out.append("")
            out.append("\033[1mRun in another terminal pane (highlight with mouse to copy):\033[0m")
            for cmd in q["starter_cmds"]:
                out.append(f"  \033[32m$\033[0m {render_tpl(cmd, user)}")

            if show_hint:
                out.append("")
                out.append("\033[1;36mHint:\033[0m")
                for line in render_tpl(q["hint"], user).splitlines():
                    out.append(f"  {line}")

            if show_sol:
                out.append("")
                out.append("\033[1;35mExact Solution Commands:\033[0m")
                for cmd in q["solution_cmds"]:
                    for idx_l, line in enumerate(render_tpl(cmd, user).splitlines()):
                        prefix = "  \033[32m$\033[0m " if idx_l == 0 else "    "
                        out.append(f"{prefix}{line}")

        out.append("")
        out.append("\033[2m" + ("─" * 76) + "\033[0m")
        out.append(
            "\033[1mKeys:\033[0m [1-6/n/p] Quest  [h] Hint  [s] Solution  "
            "[b] Classroom  [w] Start Web UI  [r] Refresh  [q] Quit"
        )
        sys.stdout.write("\n".join(out) + "\n")
        sys.stdout.flush()

    try:
        tty.setcbreak(fd)
        last_refresh = 0.0
        snap = k8s.get_snapshot(force=True)
        render_screen(snap)
        last_refresh = time.monotonic()

        while True:
            rlist, _, _ = select.select([sys.stdin], [], [], 0.5)
            if rlist:
                ch = sys.stdin.read(1)
                if ch == "\x1b":
                    # Arrow key escape sequence
                    if select.select([sys.stdin], [], [], 0.03)[0]:
                        seq = sys.stdin.read(2)
                        if seq == "[C":
                            board_mode = False
                            quest_idx = (quest_idx + 1) % len(QUESTS)
                        elif seq == "[D":
                            board_mode = False
                            quest_idx = (quest_idx - 1) % len(QUESTS)
                elif ch in ("q", "Q", "\x03"):
                    break
                elif ch in "123456":
                    board_mode = False
                    quest_idx = int(ch) - 1
                    show_hint = False
                    show_sol = False
                elif ch in ("n", "N"):
                    board_mode = False
                    quest_idx = (quest_idx + 1) % len(QUESTS)
                    show_hint = False
                    show_sol = False
                elif ch in ("p", "P"):
                    board_mode = False
                    quest_idx = (quest_idx - 1) % len(QUESTS)
                    show_hint = False
                    show_sol = False
                elif ch in ("h", "H"):
                    board_mode = False
                    show_hint = not show_hint
                elif ch in ("s", "S"):
                    board_mode = False
                    show_sol = not show_sol
                elif ch in ("b", "B"):
                    board_mode = not board_mode
                elif ch in ("w", "W") and web_srv is None:
                    for try_port in (8080, 8081, 8888):
                        try:
                            web_srv = start_web_server(k8s, "::", try_port, background=True)
                            web_url = f"http://localhost:{try_port}"
                            break
                        except OSError:
                            continue
                elif ch in ("r", "R"):
                    snap = k8s.get_snapshot(force=True)
                    last_refresh = time.monotonic()
                render_screen(snap)

            if (time.monotonic() - last_refresh) >= 3.0:
                snap = k8s.get_snapshot()
                last_refresh = time.monotonic()
                render_screen(snap)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_term)
        if web_srv is not None:
            web_srv.shutdown()
        print("\nExited Quest Lab. Your progress stays saved in namespace ConfigMap!")
    return 0


def print_check_summary(k8s: K8sClient, user: str) -> int:
    snap = k8s.get_snapshot(force=True)
    u_state = (snap.get("users") or {}).get(user) if user else None
    checks = (u_state or {}).get("checks") or {}
    score = (u_state or {}).get("score", 0)
    total = snap.get("total_checks", 11)

    print(f"=== Berkelium Quest Verification (attendee: {user or 'unset'} | {score}/{total} verified) ===")
    if not snap.get("connected"):
        print(f"Warning: Cluster unreachable ({snap.get('error')})")
    for q in QUESTS:
        print(f"\nQuest {q['num']} — {q['title']}")
        for c in q["checks"]:
            mark = "[✓]" if checks.get(c["id"]) else "[ ]"
            print(f"  {mark} {render_tpl(c['title'], user)}")
    return 0


def print_board_summary(k8s: K8sClient) -> int:
    snap = k8s.get_snapshot(force=True)
    tel = snap.get("telemetry") or {}
    total = snap.get("total_checks", 11)
    print(
        f"=== Classroom Leaderboard (ns: {snap.get('namespace')} | "
        f"attendees: {tel.get('attendees', 0)} | active pods: {tel.get('running_pods', 0)}) ==="
    )
    print(f"{'Attendee':<18} {'Q01':<5} {'Q02':<5} {'Q03':<5} {'Q04':<5} {'Q05':<5} {'Q06':<5} Score")
    for st in sorted((snap.get("users") or {}).values(), key=lambda x: (-x["score"], x["user"])):
        cols = []
        for q in QUESTS:
            dc = sum(1 for c in q["checks"] if st["checks"].get(c["id"]))
            cols.append(" ✓   " if dc == len(q["checks"]) else (f"{dc}/{len(q['checks'])}  " if dc else " ·   "))
        print(f"{st['user']:<18} " + " ".join(cols) + f" {st['score']}/{total}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Berkelium Interactive Quest Engine & Live Classroom Hub")
    parser.add_argument("--web", action="store_true", help="Run Browser Quest UI & Classroom Live HTTP server")
    parser.add_argument("--stop", action="store_true", help="Stop any background ./lab --web server")
    parser.add_argument("--host", default="::", help="Bind address for --web (default: '::' dual-stack IPv6+IPv4)")
    parser.add_argument("--port", type=int, default=8080, help="Port for --web (default: 8080)")
    parser.add_argument("--user", default="", help="Override attendee suffix (default: from .training-user)")
    parser.add_argument("--check", action="store_true", help="Print one-shot Quest verification status and exit")
    parser.add_argument("--board", action="store_true", help="Print one-shot Classroom Leaderboard and exit")
    parser.add_argument("--demo", action="store_true", help="Use simulated cluster telemetry (offline preview)")
    args = parser.parse_args()

    user = sanitize_user(args.user) or read_local_user()
    k8s = K8sClient(demo_mode=args.demo)

    if args.stop:
        killed = _stop_existing_lab_web()
        print(f"Stopped ./lab --web (PID {', '.join(map(str, killed))})." if killed else "No background ./lab --web process found.")
        return 0
    if args.check:
        return print_check_summary(k8s, user)
    if args.board:
        return print_board_summary(k8s)
    if args.web:
        srv = start_web_server(k8s, args.host, args.port, background=False)
        display_host = "localhost" if args.host in ("0.0.0.0", "::", "127.0.0.1", "::1") else args.host
        print("======================================================================")
        print("Berkelium Quest Companion & Live Classroom Hub")
        print(f"  Attendee Quest View : http://{display_host}:{args.port}/" + (f"?user={user}" if user else ""))
        print(f"  Classroom Projector : http://{display_host}:{args.port}/?view=classroom")
        if os.environ.get("CODER") or os.environ.get("CODER_AGENT_URL"):
            print("  Coder Workspace     : Click 'Open in Browser (8080)' popup or VS Code 'Ports' tab!")
        print("  Press Ctrl+C to stop.")
        print("======================================================================", flush=True)
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            print("\nStopped web server.")
        return 0

    return run_tui(k8s, user)


if __name__ == "__main__":
    raise SystemExit(main())
