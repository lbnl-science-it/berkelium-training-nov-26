def sanitize_user(raw: str) -> str:
    s = re.sub(r"@.*$", "", raw.strip().lower())
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:16].rstrip("-")
    return s


def read_configured_user() -> str:
    if os.path.isfile(STATE_FILE):
        try:
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                return sanitize_user(f.read())
        except OSError:
            pass
    return ""


def read_local_user() -> str:
    configured = read_configured_user()
    if configured:
        return configured
    for env_key in ("CODER_WORKSPACE_OWNER_NAME", "CODER_USERNAME"):
        if os.environ.get(env_key):
            return sanitize_user(os.environ[env_key])
    return ""


def render_tpl(text: str, user: str) -> str:
    if user:
        return text.replace("{u}", user)
    return text.replace("-{u}", "").replace("{u}", "demo")


