<script>
const QUESTS = __QUESTS_JSON__;
const INITIAL_USER = __INITIAL_USER_JSON__;
const SUGGESTED_USER = __SUGGESTED_USER_JSON__;
const INITIAL_CAN_SETUP = __CAN_SETUP_JSON__;
const INITIAL_SETUP_COMPLETE = __SETUP_COMPLETE_JSON__;
const CSRF_TOKEN = __CSRF_TOKEN_JSON__;

let activeUser = '';
let activeQuestIdx = 0;
let latestSnap = null;
let snippetCounter = 0;
let setupManuallyOpen = false;
let setupHideTimer = null;

function sanitizeUser(raw) {
  return String(raw || '').trim().toLowerCase().replace(/@.*$/, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 16).replace(/-+$/g, '');
}

function tpl(str) {
  if (activeUser) return str.replaceAll('{u}', activeUser);
  return str.replaceAll('-{u}', '').replaceAll('{u}', 'demo');
}

function esc(s) {
  return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function codeBlockHtml(codeText, label) {
  const id = 'code-snip-' + (++snippetCounter);
  return `<div class="copyable">
    <span class="copy">
      <button type="button" class="copy-button" command="--copy" commandfor="${id}" aria-label="${esc('Copy ' + label)}">Copy</button>
      <span class="tip" role="status"></span>
    </span>
    <pre class="code-surface" id="${id}">${esc(codeText)}</pre>
  </div>`;
}

// Copy button implementation (modern-web-guidance: Invoker Commands + fallback + accessible live status)
const copyTimers = new WeakMap();
let lastStatusMsg = '';

function legacyCopy(text) {
  const field = Object.assign(document.createElement('textarea'), { value: text });
  field.setAttribute('readonly', '');
  field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0';
  document.body.append(field);
  field.select();
  try { return document.execCommand('copy'); } finally { field.remove(); }
}

function reportCopy(button, ok) {
  const tip = button.nextElementSibling;
  if (!tip) return;
  clearTimeout(copyTimers.get(button));
  button.removeAttribute('data-copied');
  button.removeAttribute('data-failed');
  let message = ok ? 'Copied' : 'Copy failed';
  if (message === lastStatusMsg) message += '\u00A0';
  lastStatusMsg = message;
  tip.textContent = '';
  void button.offsetWidth;
  button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
  requestAnimationFrame(() => { tip.textContent = message; });
  copyTimers.set(button, setTimeout(() => {
    button.removeAttribute('data-copied');
    button.removeAttribute('data-failed');
    tip.textContent = '';
  }, 2000));
}

async function performCopy(button, target) {
  const text = target.matches('input, textarea') ? target.value : target.innerText.trim();
  if (!text) return;
  try {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      if (!legacyCopy(text)) throw new Error('Copy failed');
    }
    reportCopy(button, true);
  } catch {
    reportCopy(button, false);
  }
}

if ('CommandEvent' in window) {
  document.addEventListener('command', (event) => {
    if (event.command && event.command.startsWith('--copy')) {
      performCopy(event.source, event.target);
    }
  }, true);
} else {
  document.addEventListener('click', (event) => {
    const button = event.target.closest('button[command^="--copy"]');
    if (!button) return;
    const target = document.getElementById(button.getAttribute('commandfor'));
    if (target) performCopy(button, target);
  });
}

// Accessible Tabs
const tablist = document.getElementById('main-tablist');
const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));

function selectTab(selectedTab, moveFocus = false) {
  for (const tab of tabs) {
    const isSel = tab === selectedTab;
    tab.setAttribute('aria-selected', String(isSel));
    tab.toggleAttribute('focusgroupstart', isSel);
    const panel = document.getElementById(tab.dataset.panel);
    if (panel) {
      if (isSel) {
        panel.hidden = false;
        panel.setAttribute('tabindex', '0');
      } else {
        panel.hidden = 'until-found';
        panel.removeAttribute('tabindex');
      }
    }
  }
  if (moveFocus) selectedTab.focus();
}

for (const tab of tabs) {
  tab.addEventListener('click', () => selectTab(tab, false));
}

if (!Object.hasOwn(HTMLElement.prototype, 'focusGroup')) {
  tablist.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    const idx = tabs.indexOf(document.activeElement);
    if (idx < 0) return;
    e.preventDefault();
    const next = tabs[(idx + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
    selectTab(next, true);
  });
}

document.addEventListener('beforematch', (e) => {
  const panel = e.target.closest('[role="tabpanel"]');
  if (!panel) return;
  const tab = tabs.find(t => t.dataset.panel === panel.id);
  if (tab) selectTab(tab, false);
});

// Render UI
function getUserState() {
  if (!latestSnap || !activeUser) return null;
  return (latestSnap.users && latestSnap.users[activeUser]) || null;
}

function renderQuestView() {
  const uState = getUserState();
  const checksMap = (uState && uState.checks) || {};
  const questsMap = (uState && uState.quests) || {};
  const score = uState ? uState.score : 0;
  const total = (latestSnap && latestSnap.total_checks) || 11;

  document.getElementById('user-score-label').textContent = `${score} / ${total}`;
  document.getElementById('user-progress-fill').style.inlineSize = `${Math.round((score / total) * 100)}%`;

  const navEl = document.getElementById('quest-nav-items');
  navEl.innerHTML = QUESTS.map((q, idx) => {
    const done = Boolean(questsMap[q.id]);
    const doneCnt = q.checks.filter(c => checksMap[c.id]).length;
    return `<button type="button" class="quest-item-btn" data-qidx="${idx}" aria-current="${idx === activeQuestIdx}">
      <span><strong>${esc(q.num)}.</strong> ${esc(q.title)}</span>
      <span class="q-badge" data-done="${done}">${done ? '✓' : doneCnt + '/' + q.checks.length}</span>
    </button>`;
  }).join('');

  navEl.querySelectorAll('.quest-item-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeQuestIdx = Number(btn.dataset.qidx);
      renderQuestView();
    });
  });

  const q = QUESTS[activeQuestIdx];
  const openDetails = new Set(
    Array.from(document.querySelectorAll('#quest-detail-card details[open]')).map(d => d.dataset.did)
  );
  snippetCounter = 0;

  const setupCardEl = document.getElementById('setup-card');
  const setupReminder = (!activeUser && (!setupCardEl || setupCardEl.hidden))
    ? `<div class="why-callout" style="border-inline-start-color:var(--warn);">
        <strong>Set your attendee suffix above first!</strong> Enter your workshop name in the top-right <strong>Attendee</strong> box so live auto-verification tracks your pods &amp; jobs in <code>training-nov-26</code>.
       </div>`
    : '';

  const checksHtml = q.checks.map((c) => {
    const ok = Boolean(checksMap[c.id]);
    return `<div class="check-row" data-ok="${ok}">
      <span class="check-icon">${ok ? '[✓]' : '[ ]'}</span>
      <div>
        <div class="check-title">${esc(tpl(c.title))}</div>
        <div class="check-detail">${esc(tpl(c.detail))}</div>
      </div>
    </div>`;
  }).join('');

  const starterText = q.starter_cmds.map(tpl).join('\n');
  const solutionText = q.solution_cmds.map(tpl).join('\n\n');

  document.getElementById('quest-detail-card').innerHTML = `
    ${setupReminder}
    <div class="quest-header">
      <h2>Quest ${esc(q.num)} — ${esc(q.title)}</h2>
      <span class="q-badge">${esc(q.duration)} · ${esc(q.module)}</span>
    </div>
    <div class="why-callout"><strong>Why this matters on Berkelium:</strong> ${esc(q.why)}</div>
    <h3 style="margin:0 0 0.5rem;font-size:0.95rem;">Live Auto-Verified Cluster Objectives</h3>
    <div class="checks-list">${checksHtml}</div>
    <h3 style="margin:0 0 0.35rem;font-size:0.95rem;">Run in Your Terminal</h3>
    ${codeBlockHtml(starterText, 'Quest ' + q.num + ' starter commands')}
    <div class="disclosures">
      <details class="disclosure" data-did="hint-${q.id}" ${openDetails.has('hint-' + q.id) ? 'open' : ''}>
        <summary>Need a Hint?</summary>
        <div class="disclosure-body"><pre class="code-surface" style="padding-inline-end:0.9rem;">${esc(tpl(q.hint))}</pre></div>
      </details>
      <details class="disclosure" data-did="sol-${q.id}" ${openDetails.has('sol-' + q.id) ? 'open' : ''}>
        <summary>Short on Time? Show Exact Solution Commands</summary>
        <div class="disclosure-body">${codeBlockHtml(solutionText, 'Quest ' + q.num + ' solution commands')}</div>
      </details>
    </div>
  `;
}

function renderClassroomView() {
  if (!latestSnap) return;
  const tel = latestSnap.telemetry || {};
  document.getElementById('classroom-stats').innerHTML = [
    ['Active Attendees', tel.attendees ?? 0],
    ['Total Quests Solved', tel.quests_solved_total ?? 0],
    ['Active Namespace Pods', tel.running_pods ?? 0],
    ['Active DRA GPU / MIG Claims', tel.active_dra_claims ?? 0],
  ].map(([lbl, val]) => `
    <div class="stat-card">
      <div class="stat-value">${esc(val)}</div>
      <div class="stat-label">${esc(lbl)}</div>
    </div>
  `).join('');

  const pools = tel.gpu_pools || [];
  document.getElementById('gpu-grid').innerHTML = pools.length
    ? pools.map(p => `
        <div class="gpu-card" data-busy="${p.workshop_active > 0 || p.mig_slices > 0}">
          <div class="gpu-title">${esc(p.model)}</div>
          <div class="gpu-meta">${esc(p.schedulable_nodes)}/${esc(p.nodes)} nodes ready · ${esc(p.total_gpus)} physical GPUs</div>
          <div class="gpu-meta" style="color:var(--ok);font-weight:600;">
            Workshop active: ${esc(p.workshop_active)} pod(s)${p.mig_slices ? ' · ' + esc(p.mig_slices) + ' MIG slice(s)' : ''}
          </div>
        </div>
      `).join('')
    : '<div style="color:var(--muted);font-size:0.9rem;">Waiting for node telemetry...</div>';

  const usersList = Object.values(latestSnap.users || {}).sort((a, b) => (b.score - a.score) || a.user.localeCompare(b.user));
  const tbody = document.getElementById('matrix-tbody');
  if (!usersList.length) {
    tbody.innerHTML = '<tr><td colspan="8" style="color:var(--muted);padding:1.25rem;">No attendee resources detected in training-nov-26 yet — run <code>./setup.sh</code> and start Quest 01!</td></tr>';
    return;
  }
  tbody.innerHTML = usersList.map(st => {
    const cells = QUESTS.map(q => {
      const doneCnt = q.checks.filter(c => st.checks[c.id]).length;
      if (doneCnt === q.checks.length) return `<td style="color:var(--ok);font-weight:700;">✓ Done</td>`;
      if (doneCnt > 0) return `<td style="color:var(--warn);font-weight:600;">${doneCnt}/${q.checks.length}</td>`;
      return `<td style="color:var(--muted);">—</td>`;
    }).join('');
    return `<tr>
      <th scope="row">${esc(st.user)}</th>
      ${cells}
      <td><strong>${esc(st.score)}/${esc(latestSnap.total_checks)}</strong></td>
    </tr>`;
  }).join('');
}

const setupCard = document.getElementById('setup-card');
const setupForm = document.getElementById('workshop-setup-form');
const setupCodeInput = document.getElementById('setup-code');
const setupUserInput = document.getElementById('setup-user');
const setupSubmitBtn = document.getElementById('setup-submit-btn');
const setupCancelBtn = document.getElementById('setup-cancel-btn');
const setupStatusEl = document.getElementById('setup-status');
const reopenSetupBtn = document.getElementById('reopen-setup-btn');

// Required-field feedback ARIA sync + polite live region + WeakMap fallback (modern-web-guidance)
const linkError = (el, shown) => {
  const errorId = el.dataset?.error;
  if (!errorId) return;
  const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
  if (shown) ids.push(errorId);
  if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
  else el.removeAttribute('aria-describedby');
};

const announcer = document.createElement('div');
announcer.setAttribute('aria-live', 'polite');
announcer.classList.add('visually-hidden');
document.body.append(announcer);
let announceTimer;
let announcedField;

const spokenText = (node) => {
  const copy = node.cloneNode(true);
  copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
  copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
  return copy.textContent.replace(/\s+/g, ' ').trim();
};

const announceError = (el) => {
  const error = document.getElementById(el.dataset.error);
  if (!error) return;
  const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : '';
  clearTimeout(announceTimer);
  announcer.textContent = '';
  announcedField = el;
  announceTimer = setTimeout(() => { announcer.textContent = label + spokenText(error); }, 500);
};

const flagged = new WeakSet();
const announced = new WeakSet();
const syncAria = (el, announce = false) => {
  if (!el.matches?.('input, select, textarea')) return;
  let invalid = false;
  try { invalid = el.matches(':user-invalid'); } catch { return; }
  if (invalid) {
    if (announce && !announced.has(el)) {
      announceError(el);
      announced.add(el);
    }
    el.setAttribute('aria-invalid', 'true');
    linkError(el, true);
    flagged.add(el);
  } else if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
    el.setAttribute('aria-invalid', 'false');
    linkError(el, false);
    flagged.delete(el);
    announced.delete(el);
    if (announcedField === el) {
      clearTimeout(announceTimer);
      announcer.textContent = '';
    }
  }
};

const UserInvalidFallback = (() => {
  const dirtyState = new WeakMap();
  const updateState = (input) => {
    const isValid = input.validity.valid;
    input.classList.toggle('user-invalid-fallback', !isValid);
    input.classList.toggle('user-valid-fallback', isValid);
    input.setAttribute('aria-invalid', isValid ? 'false' : 'true');
    linkError(input, !isValid);
  };
  const handleEvent = (event) => {
    const input = event.target;
    if (event.type === 'reset') {
      for (const control of (input.elements || [])) {
        dirtyState.delete(control);
        control.classList.remove('user-invalid-fallback', 'user-valid-fallback');
        if (control.matches('input, select, textarea')) control.setAttribute('aria-invalid', 'false');
        if (control.dataset?.error) linkError(control, false);
      }
      return;
    }
    if (!input.checkValidity) return;
    if (event.type === 'invalid') {
      dirtyState.set(input, { hasInteracted: true, hasBlurred: true });
      updateState(input);
      return;
    }
    if (event.type === 'input' || event.type === 'change') {
      const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
      state.hasInteracted = true;
      dirtyState.set(input, state);
      if (state.hasBlurred) updateState(input);
    } else if (event.type === 'blur') {
      const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
      state.hasBlurred = true;
      dirtyState.set(input, state);
      if (state.hasInteracted) updateState(input);
    }
  };
  const init = (root = document) => {
    if (CSS.supports('selector(:user-invalid)')) return;
    root.querySelectorAll('input, select, textarea').forEach((el) => {
      if (!el.hasAttribute('aria-invalid')) el.setAttribute('aria-invalid', 'false');
    });
    root.addEventListener('blur', handleEvent, true);
    root.addEventListener('input', handleEvent);
    root.addEventListener('change', handleEvent);
    root.addEventListener('invalid', handleEvent, true);
    root.addEventListener('reset', handleEvent, true);
  };
  return { init };
})();

if (CSS.supports('selector(:user-invalid)')) {
  document.querySelectorAll('input, select, textarea').forEach((el) => syncAria(el));
  document.addEventListener('blur', (e) => syncAria(e.target, true), true);
  document.addEventListener('input', (e) => {
    if (e.target.dataset?.serverInvalid) {
      delete e.target.dataset.serverInvalid;
      e.target.setAttribute('aria-invalid', 'false');
    }
    if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
  });
  document.addEventListener('change', (e) => syncAria(e.target, true), true);
  document.addEventListener('invalid', (e) => {
    announced.add(e.target);
    syncAria(e.target);
  }, true);
  document.addEventListener('reset', (e) => {
    setTimeout(() => [...e.target.elements].forEach((el) => syncAria(el)));
  }, true);
} else {
  UserInvalidFallback.init(setupForm);
}

