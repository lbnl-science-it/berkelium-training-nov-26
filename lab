class DualStackHTTPServer(http.server.ThreadingHTTPServer):
    address_family = socket.AF_INET6
    allow_reuse_address = True

    def server_bind(self) -> None:
        try:
            self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        except Exception:
            pass
        super().server_bind()


def _stop_existing_lab_web() -> list[int]:
    """Terminate any prior './lab --web' process owned by the current user so restarts never hit EADDRINUSE."""
    import signal

    killed: list[int] = []
    my_pid = os.getpid()
    my_uid = os.getuid() if hasattr(os, "getuid") else -1
    if os.path.isdir("/proc"):
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            pid = int(entry)
            if pid == my_pid:
                continue
            try:
                if my_uid >= 0 and os.stat(f"/proc/{pid}").st_uid != my_uid:
                    continue
                raw = open(f"/proc/{pid}/cmdline", "rb").read().decode("utf-8", "ignore")
                parts = [p for p in raw.split("\x00") if p]
                if any(p.endswith("/lab") or p in ("./lab", "lab") for p in parts) and "--web" in parts:
                    os.kill(pid, signal.SIGTERM)
                    killed.append(pid)
            except OSError:
                continue
    if killed:
        time.sleep(0.35)
    return killed


def _load_join_bundle() -> tuple[str, bytes] | None:
    """Load workshop join passcode + kubeconfig from mounted Secret or env (never from git)."""
    code = os.environ.get("TRAINING_JOIN_CODE", "").strip()
    kc_path = os.environ.get("TRAINING_JOIN_KUBECONFIG", "").strip()
    secret_dir = "/etc/hub-join"
    if not code and os.path.isfile(os.path.join(secret_dir, "code")):
        try:
            with open(os.path.join(secret_dir, "code"), "r", encoding="utf-8") as f:
                code = f.read().strip()
        except OSError:
            pass
    if not kc_path and os.path.isfile(os.path.join(secret_dir, "kubeconfig.yaml")):
        kc_path = os.path.join(secret_dir, "kubeconfig.yaml")

    if not code or not kc_path or not os.path.isfile(kc_path):
        return None
    try:
        with open(kc_path, "rb") as f:
            data = f.read()
        if b"clusters:" not in data:
            return None
        return (code, data)
    except OSError:
        return None


def make_http_handler(k8s: K8sClient):
    quests_json_str = json.dumps(QUESTS)
    csrf_token = secrets.token_urlsafe(24)
    rate_lock = threading.Lock()
    setup_lock = threading.Lock()
    failed_attempts: dict[str, list[float]] = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, fmt: str, *args: Any) -> None:
            return

        def _send_json(self, code: int, obj: dict[str, Any]) -> None:
            self._send_bytes(code, "application/json; charset=utf-8", json.dumps(obj).encode("utf-8"))

        def do_GET(self) -> None:
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path == "/healthz":
                self._send_bytes(200, "text/plain; charset=utf-8", b"ok")
                return
            if parsed.path == "/kubeconfig":
                bundle = _load_join_bundle()
                if bundle is None:
                    self._send_bytes(
                        404,
                        "text/plain; charset=utf-8",
                        b"Workshop kubeconfig bundle not configured on this hub instance.\n",
                    )
                    return
                expected_code, kc_bytes = bundle
                client_ip = (
                    self.headers.get("X-Forwarded-For", "").split(",")[0].strip()
                    or self.client_address[0]
                )
                now = time.monotonic()
                with rate_lock:
                    recent = [t for t in failed_attempts.get(client_ip, []) if (now - t) < 60.0]
                    failed_attempts[client_ip] = recent
                    if len(recent) >= 6:
                        self._send_bytes(
                            429,
                            "text/plain; charset=utf-8",
                            b"Too many invalid join code attempts. Wait 60 seconds and try again.\n",
                        )
                        return

                qs = urllib.parse.parse_qs(parsed.query)
                provided = (
                    self.headers.get("X-Workshop-Code", "").strip()
                    or (qs.get("code") or [""])[0].strip()
                )
                if not provided or not hmac.compare_digest(provided.encode("utf-8"), expected_code.encode("utf-8")):
                    with rate_lock:
                        failed_attempts.setdefault(client_ip, []).append(now)
                    self._send_bytes(
                        403,
                        "text/plain; charset=utf-8",
                        b"Invalid or missing Workshop Join Code.\n",
                    )
                    return

                self._send_bytes(
                    200,
                    "application/x-yaml; charset=utf-8",
                    kc_bytes,
                    extra_headers={"Content-Disposition": 'attachment; filename="kubeconfig.yaml"'},
                )
                return
            if parsed.path == "/api/state":
                snap = k8s.get_snapshot()
                body = json.dumps(snap).encode("utf-8")
                self._send_bytes(200, "application/json; charset=utf-8", body)
                return
            if parsed.path in ("/", "/index.html"):
                k8s._maybe_reload_transport()
                configured_u = read_configured_user()
                suggested_u = read_local_user()
                can_setup = k8s.can_local_setup()
                setup_complete = bool(
                    (not can_setup)
                    or (k8s.mode in ("rest-kubeconfig", "kubectl") and configured_u)
                )
                html_bytes = (
                    WEB_HTML.replace("__QUESTS_JSON__", quests_json_str)
                    .replace("__INITIAL_USER_JSON__", json.dumps(configured_u))
                    .replace("__SUGGESTED_USER_JSON__", json.dumps(suggested_u))
                    .replace("__CAN_SETUP_JSON__", json.dumps(can_setup))
                    .replace("__SETUP_COMPLETE_JSON__", json.dumps(setup_complete))
                    .replace("__CSRF_TOKEN_JSON__", json.dumps(csrf_token))
                    .replace("__CSRF_TOKEN__", csrf_token)
                    .encode("utf-8")
                )
                self._send_bytes(200, "text/html; charset=utf-8", html_bytes)
                return
            self._send_bytes(404, "text/plain; charset=utf-8", b"Not Found")

        def do_POST(self) -> None:
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path not in ("/api/setup", "/setup"):
                self._send_json(404, {"ok": False, "error": "Not Found"})
                return
            if not k8s.can_local_setup():
                self._send_json(403, {"ok": False, "error": "Local workspace setup is disabled on the shared classroom hub."})
                return

            sec_site = self.headers.get("Sec-Fetch-Site", "").strip().lower()
            if sec_site and sec_site not in ("same-origin", "none"):
                self._send_json(403, {"ok": False, "error": "Cross-site requests are not permitted."})
                return

            try:
                content_len = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                content_len = 0
            if content_len <= 0 or content_len > 16384:
                self._send_json(400, {"ok": False, "error": "Invalid request payload."})
                return

            raw_body = self.rfile.read(content_len).decode("utf-8", "replace")
            ctype = self.headers.get("Content-Type", "").lower()
            if "application/json" in ctype:
                try:
                    payload = json.loads(raw_body)
                    if not isinstance(payload, dict):
                        payload = {}
                except Exception:
                    self._send_json(400, {"ok": False, "error": "Invalid JSON body."})
                    return
            else:
                form_qs = urllib.parse.parse_qs(raw_body, keep_blank_values=True)
                payload = {k: (v[0] if v else "") for k, v in form_qs.items()}

            provided_csrf = (
                self.headers.get("X-CSRF-Token", "").strip()
                or str(payload.get("csrf_token") or "").strip()
            )
            if not provided_csrf or not hmac.compare_digest(provided_csrf, csrf_token):
                self._send_json(403, {"ok": False, "error": "Page session refreshed — reload the page and try again."})
                return

            raw_code = str(payload.get("code") or "").strip()
            user = sanitize_user(str(payload.get("user") or ""))
            if not user:
                self._send_json(
                    400,
                    {"ok": False, "error": "Enter your LBNL username or initials (letters and numbers).", "field": "user"},
                )
                return

            k8s._maybe_reload_transport()
            already_has_kc = k8s.mode in ("rest-kubeconfig", "kubectl")
            if not raw_code and not already_has_kc:
                self._send_json(
                    400,
                    {"ok": False, "error": "Enter the Workshop Join Code shown on the instructor's slide.", "field": "code"},
                )
                return
            if raw_code.startswith("-"):
                self._send_json(
                    400,
                    {"ok": False, "error": "Invalid Workshop Join Code — check the code on the slide.", "field": "code"},
                )
                return

            setup_sh = os.path.join(REPO_ROOT, "setup.sh")
            cmd = ["/bin/bash", setup_sh]
            if raw_code:
                cmd.extend(["--code", raw_code, user])
            else:
                cmd.append(user)

            with setup_lock:
                try:
                    proc = subprocess.run(
                        cmd,
                        cwd=REPO_ROOT,
                        stdin=subprocess.DEVNULL,
                        capture_output=True,
                        text=True,
                        timeout=25,
                    )
                except subprocess.TimeoutExpired:
                    self._send_json(504, {"ok": False, "error": "Setup timed out contacting the cluster — try again."})
                    return

                if proc.returncode != 0:
                    err_lines = [ln.strip() for ln in (proc.stderr or proc.stdout or "").splitlines() if ln.strip()]
                    err_msg = err_lines[-1] if err_lines else "Invalid Workshop Join Code — double-check the slide."
                    self._send_json(
                        400,
                        {"ok": False, "error": err_msg, "field": "code" if raw_code else "user"},
                    )
                    return

                k8s._init_transport()
                snap = k8s.get_snapshot(force=True)

            accept_hdr = self.headers.get("Accept", "").lower()
            if "application/json" not in accept_hdr and "application/json" not in ctype:
                dest = f"/?user={urllib.parse.quote(user)}"
                self._send_bytes(303, "text/plain; charset=utf-8", b"Redirecting...", extra_headers={"Location": dest})
                return

            self._send_json(
                200,
                {
                    "ok": True,
                    "user": user,
                    "snapshot": snap,
                    "message": f"Connected to {snap.get('namespace')}! Installed ~/.kube/config and personalized manifests with '-{user}'.",
                },
            )

        def _send_bytes(
            self,
            code: int,
            content_type: str,
            data: bytes,
            extra_headers: dict[str, str] | None = None,
        ) -> None:
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            if extra_headers:
                for hk, hv in extra_headers.items():
                    self.send_header(hk, hv)
            self.end_headers()
            self.wfile.write(data)

    return Handler


def start_web_server(k8s: K8sClient, host: str, port: int, background: bool = False) -> http.server.ThreadingHTTPServer:
    import errno

    handler = make_http_handler(k8s)

    def _bind_once() -> http.server.ThreadingHTTPServer:
        if ":" in host:
            try:
                return DualStackHTTPServer((host, port), handler)
            except OSError as e:
                if e.errno == errno.EADDRINUSE:
                    raise
                if host == "::":
                    return http.server.ThreadingHTTPServer(("0.0.0.0", port), handler)
                raise
        return http.server.ThreadingHTTPServer((host, port), handler)

    try:
        srv = _bind_once()
    except OSError as e:
        if e.errno == errno.EADDRINUSE:
            killed = _stop_existing_lab_web()
            if killed:
                print(f"Restarting ./lab --web on port {port} (stopped previous PID {', '.join(map(str, killed))})...")
                srv = _bind_once()
            else:
                raise
        else:
            raise

    if background:
        t = threading.Thread(target=srv.serve_forever, daemon=True)
        t.start()
    return srv


